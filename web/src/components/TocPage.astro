---
// A document's <main> with a table of contents: a sidebar that follows the reader on wide
// screens, a folded list under the title (slot "top") on narrow ones, the section being read
// marked. Without entries it is a plain document column.
import type { Lang } from '../i18n';

export interface TocEntry { depth: number; slug: string; text: string }
const { lang, entries } = Astro.props as { lang: Lang; entries: TocEntry[] };
const label = lang === 'zh' ? '目录' : 'Contents';
---
<main class:list={['wrap doc', { 'has-toc': entries.length > 0 }]}>
  {entries.length > 0 && (
    <nav class="toc toc-side" aria-label={label}>
      <div class="toc-title">{label}</div>
      <ol>{entries.map((h) => <li class={`toc-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>
  )}
  <article class="doc-body">
    <slot name="top" />
    {entries.length > 0 && (
      <details class="toc toc-inline">
        <summary>{label}</summary>
        <ol>{entries.map((h) => <li class={`toc-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <slot />
  </article>
</main>
{entries.length > 0 && (
  <script is:inline>
    // Marks the section being read in the sidebar: the last heading scrolled up to just under
    // the header, or the last one of all at the bottom of the page (short final sections
    // never reach the top).
    (() => {
      const links = [...document.querySelectorAll('.toc-side a')];
      const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
      const update = () => {
        let current = 0;
        targets.forEach((el, i) => { if (el && el.getBoundingClientRect().top < 160) current = i; });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = links.length - 1;
        links.forEach((a, i) => (i === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      };
      addEventListener('scroll', update, { passive: true });
      update();
      // Picking a section on a phone folds the list away again.
      document.querySelectorAll('.toc-inline a').forEach((a) =>
        a.addEventListener('click', () => a.closest('details').removeAttribute('open')));
    })();
  </script>
)}
