// How Cloudflare publishes the website: Workers Builds runs `npx astro build` in web/, then
// `npx wrangler deploy`, which uploads dist/ as static assets. /guide serves guide.html and
// /zh/ zh/index.html, by default; an address with no page gets 404.html. Only /api/* runs
// the Worker (worker/index.js), which keeps reports sent from the app in the R2 bucket
// castbay-reports (created by hand, with a rule deleting objects after 90 days).
{
  "name": "castbay",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "castbay-reports" }],
  // At most 5 reports a minute from one address.
  "ratelimits": [{ "name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "routes": [{ "pattern": "castbay.weenas.com", "custom_domain": true }]
}
