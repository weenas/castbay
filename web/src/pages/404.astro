---
// Shown for any address the site doesn't have (wrangler.jsonc: not_found_handling), in both
// languages, as the reader's language isn't known.
import Page from '../layouts/Page.astro';
---
<Page lang="en" title="Page not found – CastBay" description="This page doesn't exist on the CastBay website.">
<main class="wrap doc not-found">
    <h1>Page not found</h1>
    <p>This page doesn't exist, or has moved. Try the <a href="/">home page</a>, the <a href="/guide">user guide</a> or the <a href="/changelog">changelog</a>.</p>
    <h1 lang="zh-CN">找不到这个页面</h1>
    <p lang="zh-CN">这个页面不存在或已经移动。可以回到<a href="/zh/">主页</a>，或看看<a href="/zh/guide">使用说明</a>和<a href="/zh/changelog">更新日志</a>。</p>
</main>
</Page>
